

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>For My Love</title>
<link href="https://fonts.googleapis.com/css2?family=Dancing+Script:wght@400;700&family=Poppins:wght@300;400;500;600&display=swap" rel="stylesheet">
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }

body {
  font-family: 'Poppins', sans-serif;
  min-height: 100vh;
  background: linear-gradient(135deg, #ffb3c1 0%, #ff9eb5 30%, #ff8da1 60%, #ff7b94 100%);
  overflow-x: hidden;
}

#gate {
  position: fixed; inset: 0;
  display: flex; align-items: center; justify-content: center;
  background: linear-gradient(135deg, #ffb3c1 0%, #ff9eb5 30%, #ff8da1 60%, #ff7b94 100%);
  z-index: 9999;
  transition: opacity 0.8s ease, transform 0.8s ease;
}
#gate.hidden {
  opacity: 0; transform: scale(1.1);
  pointer-events: none;
}

.gate-card {
  background: rgba(255, 255, 255, 0.85);
  backdrop-filter: blur(20px);
  border-radius: 24px;
  padding: 50px 45px;
  text-align: center;
  box-shadow: 0 20px 60px rgba(255, 107, 129, 0.3), 0 0 0 1px rgba(255,255,255,0.5);
  max-width: 420px; width: 90%;
  animation: gateFloat 3s ease-in-out infinite;
}

@keyframes gateFloat {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-8px); }
}

.gate-title {
  font-family: 'Dancing Script', cursive;
  font-size: 2.2rem;
  color: #d6336c;
  margin-bottom: 25px;
  text-shadow: 1px 1px 2px rgba(214,51,108,0.15);
}

.gate-input {
  width: 100%; padding: 14px 18px;
  border: 2px solid #e83e8c;
  border-radius: 14px;
  font-size: 1rem; font-family: 'Poppins', sans-serif;
  background: rgba(255,255,255,0.9);
  color: #333; text-align: center;
  outline: none; transition: all 0.3s ease;
  margin-bottom: 18px;
}
.gate-input:focus {
  border-color: #d6336c;
  box-shadow: 0 0 15px rgba(232,62,140,0.25);
  transform: scale(1.02);
}

.gate-btn {
  background: linear-gradient(135deg, #e83e8c, #d6336c);
  color: white; border: none;
  padding: 14px 45px;
  border-radius: 14px;
  font-size: 1.05rem; font-weight: 600;
  cursor: pointer; transition: all 0.3s ease;
  box-shadow: 0 6px 20px rgba(232,62,140,0.35);
}
.gate-btn:hover {
  transform: translateY(-2px);
  box-shadow: 0 10px 30px rgba(232,62,140,0.45);
}
.gate-btn:active { transform: translateY(0) scale(0.98); }

.gate-error {
  color: #dc3545; font-size: 0.85rem;
  margin-top: 12px; opacity: 0; transition: opacity 0.3s;
}
.gate-error.show { opacity: 1; }

.floating-heart {
  position: fixed; pointer-events: none;
  font-size: 1.5rem; opacity: 0.6;
  animation: floatUp linear forwards;
  z-index: 1;
}
@keyframes floatUp {
  0% { transform: translateY(100vh) rotate(0deg); opacity: 0; }
  10% { opacity: 0.6; }
  90% { opacity: 0.6; }
  100% { transform: translateY(-10vh) rotate(360deg); opacity: 0; }
}

#app {
  display: none;
  min-height: 100vh;
  padding: 20px;
  padding-bottom: 120px;
}
#app.show { display: block; animation: fadeIn 1s ease; }

@keyframes fadeIn { from { opacity: 0; transform: translateY(20px); } to { opacity: 1; transform: translateY(0); } }

.welcome-banner {
  text-align: center;
  padding: 30px 20px 10px;
}
.welcome-banner h1 {
  font-family: 'Dancing Script', cursive;
  font-size: 2.8rem;
  color: #fff;
  text-shadow: 2px 2px 8px rgba(214,51,108,0.4);
  animation: welcomePulse 2s ease-in-out infinite;
}
.welcome-banner p {
  color: rgba(255,255,255,0.9);
  font-size: 1.1rem; margin-top: 8px;
  font-weight: 300;
}

@keyframes welcomePulse {
  0%, 100% { transform: scale(1); }
  50% { transform: scale(1.03); }
}

.tabs-container {
  display: flex; justify-content: center;
  gap: 12px; flex-wrap: wrap;
  padding: 20px 10px;
}

.tab-btn {
  display: flex; align-items: center; gap: 8px;
  background: rgba(255,255,255,0.85);
  backdrop-filter: blur(10px);
  border: 2px solid rgba(255,255,255,0.6);
  border-radius: 50px;
  padding: 12px 24px;
  font-size: 0.95rem; font-weight: 500;
  color: #d6336c; cursor: pointer;
  transition: all 0.35s ease;
  box-shadow: 0 4px 15px rgba(255,107,129,0.15);
}
.tab-btn:hover {
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(255,107,129,0.3);
  background: rgba(255,255,255,0.95);
}
.tab-btn.active {
  background: linear-gradient(135deg, #e83e8c, #d6336c);
  color: white; border-color: transparent;
  box-shadow: 0 6px 20px rgba(232,62,140,0.4);
}
.tab-btn .tab-icon { font-size: 1.1rem; }

.content-area {
  max-width: 800px; margin: 0 auto;
  padding: 10px 5px 40px;
}

.tab-content {
  display: none;
  background: rgba(255,255,255,0.88);
  backdrop-filter: blur(20px);
  border-radius: 24px;
  padding: 35px;
  box-shadow: 0 15px 50px rgba(255,107,129,0.2), 0 0 0 1px rgba(255,255,255,0.5);
  animation: cardIn 0.5s ease;
}
.tab-content.active { display: block; }

@keyframes cardIn {
  from { opacity: 0; transform: translateY(15px) scale(0.98); }
  to { opacity: 1; transform: translateY(0) scale(1); }
}

.letter-header {
  font-family: 'Dancing Script', cursive;
  font-size: 2rem;
  color: #d6336c;
  margin-bottom: 5px;
}
.letter-sub {
  font-family: 'Dancing Script', cursive;
  font-size: 1.4rem;
  color: #e83e8c;
  margin-bottom: 20px;
}
.letter-divider {
  height: 2px;
  background: linear-gradient(90deg, transparent, #ffb3c1, transparent);
  margin: 15px 0 25px;
}
.letter-body {
  font-family: 'Dancing Script', cursive;
  font-size: 1.3rem;
  line-height: 2;
  color: #5a3a3a;
  text-align: left;
}
.letter-body p { margin-bottom: 15px; }

.letter-body {
  max-height: 0;
  overflow: hidden;
  opacity: 0;
  transform: translateY(-20px);
  transition: all 0.8s cubic-bezier(0.4, 0, 0.2, 1);
}

.letter-body.expanded {
  max-height: 2000px;
  opacity: 1;
  transform: translateY(0);
}

.letter-header {
  cursor: pointer;
  user-select: none;
  transition: transform 0.3s ease;
}

.letter-header:hover {
  transform: scale(1.02);
}

.letter-header::after {
  content: ' ▼';
  font-family: 'Poppins', sans-serif;
  font-size: 0.6em;
  opacity: 0.5;
  transition: transform 0.3s ease;
  display: inline-block;
}

.letter-header.expanded::after {
  transform: rotate(180deg);
}

.letter-divider {
  transition: all 0.5s ease;
  max-width: 0;
  margin: 0 auto;
}

.letter-divider.expanded {
  max-width: 100%;
  margin: 15px 0 25px;
}

.cat-gif-container {
  text-align: center;
  margin-top: 25px;
  padding: 15px;
  background: linear-gradient(135deg, #fff0f3, #ffe4e9);
  border-radius: 20px;
}
.cat-gif-container img {
  max-width: 280px;
  border-radius: 16px;
  box-shadow: 0 8px 25px rgba(255,107,129,0.25);
}
.cat-caption {
  font-family: 'Dancing Script', cursive;
  font-size: 1.1rem;
  color: #d6336c;
  margin-top: 10px;
}

.music-header {
  font-family: 'Dancing Script', cursive;
  font-size: 2rem;
  color: #d6336c;
  text-align: center;
  margin-bottom: 25px;
}

.song-card {
  display: flex; align-items: center; gap: 18px;
  background: linear-gradient(135deg, #fff0f3, #ffe4e9);
  border-radius: 18px;
  padding: 18px 22px;
  margin-bottom: 14px;
  cursor: pointer;
  transition: all 0.3s ease;
  border: 2px solid transparent;
  position: relative;
}
.song-card:hover {
  transform: translateX(5px);
  border-color: #ffb3c1;
  box-shadow: 0 5px 20px rgba(255,107,129,0.15);
}
.song-card.playing {
  border-color: #e83e8c;
  background: linear-gradient(135deg, #ffe4e9, #ffd4dd);
  box-shadow: 0 5px 25px rgba(232,62,140,0.2);
}

.song-number {
  width: 36px; height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, #e83e8c, #d6336c);
  color: white;
  display: flex; align-items: center; justify-content: center;
  font-weight: 600; font-size: 0.85rem;
  flex-shrink: 0;
}
.song-info { flex: 1; }
.song-title {
  font-weight: 600; color: #333;
  font-size: 1rem;
}
.song-artist {
  font-size: 0.85rem; color: #888;
  margin-top: 2px;
}

.play-icon {
  width: 40px; height: 40px;
  border-radius: 50%;
  background: linear-gradient(135deg, #e83e8c, #d6336c);
  color: white;
  display: flex; align-items: center; justify-content: center;
  font-size: 0.9rem;
  flex-shrink: 0;
  transition: transform 0.2s;
}
.song-card:hover .play-icon { transform: scale(1.1); }

.song-viz {
  display: none;
  align-items: flex-end;
  gap: 2px;
  height: 20px;
  margin-right: 8px;
}
.song-card.playing .song-viz { display: flex; }
.song-viz span {
  width: 3px;
  background: linear-gradient(to top, #e83e8c, #ffb3c1);
  border-radius: 2px;
  animation: vizBar 0.6s ease-in-out infinite alternate;
}
.song-viz span:nth-child(1) { animation-delay: 0s; height: 8px; }
.song-viz span:nth-child(2) { animation-delay: 0.1s; height: 14px; }
.song-viz span:nth-child(3) { animation-delay: 0.2s; height: 10px; }
.song-viz span:nth-child(4) { animation-delay: 0.15s; height: 16px; }
.song-viz span:nth-child(5) { animation-delay: 0.05s; height: 12px; }
@keyframes vizBar {
  0% { transform: scaleY(0.4); }
  100% { transform: scaleY(1); }
}

.now-playing-bar {
  position: fixed; bottom: 0; left: 0; right: 0;
  background: rgba(255,255,255,0.95);
  backdrop-filter: blur(20px);
  padding: 15px 25px;
  display: flex; align-items: center; gap: 15px;
  box-shadow: 0 -5px 30px rgba(0,0,0,0.1);
  z-index: 100;
  transform: translateY(100%);
  transition: transform 0.4s ease;
}
.now-playing-bar.show { transform: translateY(0); }

.np-info { flex: 1; min-width: 0; }
.np-title { font-weight: 600; color: #333; font-size: 0.95rem; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
.np-artist { font-size: 0.8rem; color: #888; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }

.np-controls {
  display: flex; align-items: center; gap: 12px;
}
.np-btn {
  background: none; border: none;
  color: #d6336c; font-size: 1.2rem;
  cursor: pointer; padding: 8px;
  border-radius: 50%;
  transition: all 0.2s;
  width: 40px; height: 40px;
  display: flex; align-items: center; justify-content: center;
}
.np-btn:hover { background: rgba(232,62,140,0.1); }

.np-progress {
  position: absolute; bottom: 0; left: 0; right: 0;
  height: 3px;
  background: #ffe4e9;
}
.np-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #e83e8c, #d6336c);
  width: 0%;
  transition: width 0.1s linear;
  border-radius: 0 2px 2px 0;
}

.visualizer-bars {
  display: none; align-items: flex-end; gap: 3px;
  height: 20px;
}
.visualizer-bars.active { display: flex; }
.visualizer-bars span {
  width: 4px;
  background: linear-gradient(to top, #e83e8c, #ffb3c1);
  border-radius: 2px;
  animation: vizBar 0.8s ease-in-out infinite alternate;
}
.visualizer-bars span:nth-child(2) { animation-delay: 0.1s; }
.visualizer-bars span:nth-child(3) { animation-delay: 0.2s; }
.visualizer-bars span:nth-child(4) { animation-delay: 0.3s; }
.visualizer-bars span:nth-child(5) { animation-delay: 0.15s; }
@keyframes vizBar {
  0% { height: 4px; }
  100% { height: 18px; }
}

#realAudio { display: none; }

.notes-header {
  font-family: 'Dancing Script', cursive;
  font-size: 2rem;
  color: #d6336c;
  text-align: center;
  margin-bottom: 20px;
}

.note-input-area {
  display: flex; gap: 10px;
  margin-bottom: 20px;
}
.note-input {
  flex: 1;
  padding: 14px 18px;
  border: 2px solid #ffb3c1;
  border-radius: 14px;
  font-family: 'Poppins', sans-serif;
  font-size: 0.95rem;
  outline: none;
  transition: all 0.3s;
}
.note-input:focus {
  border-color: #e83e8c;
  box-shadow: 0 0 15px rgba(232,62,140,0.15);
}
.note-add-btn {
  background: linear-gradient(135deg, #e83e8c, #d6336c);
  color: white; border: none;
  padding: 14px 22px;
  border-radius: 14px;
  font-weight: 600; cursor: pointer;
  transition: all 0.3s;
}
.note-add-btn:hover { transform: scale(1.05); }

.notes-list {
  display: flex; flex-direction: column; gap: 12px;
}
.note-item {
  background: linear-gradient(135deg, #fff8fa, #fff0f3);
  border-radius: 16px;
  padding: 16px 20px;
  display: flex; justify-content: space-between; align-items: center;
  border-left: 4px solid #e83e8c;
  animation: noteIn 0.4s ease;
  transition: all 0.3s;
}
.note-item:hover {
  transform: translateX(5px);
  box-shadow: 0 5px 20px rgba(255,107,129,0.1);
}
@keyframes noteIn {
  from { opacity: 0; transform: translateX(-20px); }
  to { opacity: 1; transform: translateX(0); }
}
.note-text {
  font-family: 'Dancing Script', cursive;
  font-size: 1.15rem;
  color: #5a3a3a;
}
.note-delete {
  background: none; border: none;
  color: #ff6b6b; font-size: 1.2rem;
  cursor: pointer; opacity: 0.6;
  transition: opacity 0.2s;
}
.note-delete:hover { opacity: 1; }

.empty-notes {
  text-align: center;
  padding: 40px;
  color: #aaa;
  font-style: italic;
}

.gallery-header {
  font-family: 'Dancing Script', cursive;
  font-size: 2rem;
  color: #d6336c;
  text-align: center;
  margin-bottom: 20px;
}

.gallery-grid {
  display: grid;
  grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
  gap: 15px;
}

.gallery-slot {
  aspect-ratio: 1;
  background: linear-gradient(135deg, #fff0f3, #ffe4e9);
  border-radius: 18px;
  border: 3px dashed #ffb3c1;
  display: flex; flex-direction: column;
  align-items: center; justify-content: center;
  cursor: pointer;
  transition: all 0.3s;
  position: relative; overflow: hidden;
}
.gallery-slot:hover {
  border-color: #e83e8c;
  transform: scale(1.03);
  box-shadow: 0 8px 25px rgba(255,107,129,0.2);
}
.gallery-slot.has-image {
  border-style: solid; border-color: transparent;
}
.gallery-slot.has-image img {
  width: 100%; height: 100%;
  object-fit: cover;
  border-radius: 15px;
}
.gallery-slot .add-icon {
  font-size: 2.5rem; color: #ffb3c1;
  margin-bottom: 8px;
}
.gallery-slot .add-text {
  font-size: 0.85rem; color: #d6336c;
  font-weight: 500;
}
.gallery-slot input[type="file"] {
  position: absolute; inset: 0;
  opacity: 0; cursor: pointer;
}

@media (max-width: 600px) {
  .gate-card { padding: 35px 25px; }
  .gate-title { font-size: 1.8rem; }
  .welcome-banner h1 { font-size: 2rem; }
  .tab-btn { padding: 10px 16px; font-size: 0.85rem; }
  .tab-content { padding: 25px 20px; }
  .letter-header { font-size: 1.6rem; }
  .letter-body { font-size: 1.1rem; }
  .gallery-grid { grid-template-columns: repeat(2, 1fr); }
}

.sparkle {
  position: fixed; pointer-events: none;
  font-size: 1rem; opacity: 0;
  animation: sparkleAnim 1.5s ease-out forwards;
  z-index: 9998;
}
@keyframes sparkleAnim {
  0% { opacity: 1; transform: scale(0) rotate(0deg); }
  50% { opacity: 1; transform: scale(1.2) rotate(180deg); }
  100% { opacity: 0; transform: scale(0) rotate(360deg) translateY(-30px); }
}

/* ===== MEMORY MODE ===== */
.memory-tab-btn {
  background: linear-gradient(135deg, #ffd700, #ffaa00);
  color: #fff;
  border-color: transparent;
  animation: memoryPulse 2s ease-in-out infinite;
}
.memory-tab-btn:hover {
  background: linear-gradient(135deg, #ffaa00, #ff8800);
  transform: translateY(-3px);
  box-shadow: 0 8px 25px rgba(255,170,0,0.4);
}

@keyframes memoryPulse {
  0%, 100% { box-shadow: 0 4px 15px rgba(255,170,0,0.3); }
  50% { box-shadow: 0 4px 30px rgba(255,170,0,0.6), 0 0 20px rgba(255,215,0,0.3); }
}

#memoryOverlay {
  position: fixed; inset: 0;
  background: #000;
  z-index: 10000;
  display: none;
  opacity: 0;
  transition: opacity 1.5s ease;
}
#memoryOverlay.active {
  display: flex;
  opacity: 1;
}

.memory-bg-layer {
  position: absolute; inset: 0;
  background-size: cover;
  background-position: center;
  opacity: 0;
  transform: scale(1.15);
  transition: opacity 2.5s ease, transform 8s ease;
  filter: brightness(0.4) blur(2px);
}
.memory-bg-layer.active {
  opacity: 1;
  transform: scale(1);
}

.memory-main-photo {
  position: absolute;
  top: 50%; left: 50%;
  transform: translate(-50%, -50%) scale(0.8);
  max-width: 70vw;
  max-height: 70vh;
  border-radius: 20px;
  box-shadow: 0 30px 80px rgba(0,0,0,0.6), 0 0 0 1px rgba(255,255,255,0.1);
  opacity: 0;
  transition: all 2s cubic-bezier(0.4, 0, 0.2, 1);
  z-index: 2;
  object-fit: cover;
}
.memory-main-photo.active {
  opacity: 1;
  transform: translate(-50%, -50%) scale(1);
}

.memory-vignette {
  position: absolute; inset: 0;
  background: radial-gradient(ellipse at center, transparent 40%, rgba(0,0,0,0.7) 100%);
  z-index: 3;
  pointer-events: none;
}

.memory-text {
  position: absolute;
  bottom: 12%;
  left: 50%;
  transform: translateX(-50%);
  text-align: center;
  z-index: 4;
  opacity: 0;
  transition: opacity 2s ease, transform 2s ease;
}
.memory-text.active {
  opacity: 1;
  transform: translateX(-50%) translateY(0);
}

.memory-text h2 {
  font-family: 'Dancing Script', cursive;
  font-size: 3rem;
  color: #fff;
  text-shadow: 0 2px 20px rgba(255,107,129,0.5);
  margin-bottom: 10px;
  animation: textGlow 3s ease-in-out infinite;
}
.memory-text p {
  font-family: 'Poppins', sans-serif;
  font-size: 1.1rem;
  color: rgba(255,255,255,0.8);
  font-weight: 300;
}

@keyframes textGlow {
  0%, 100% { text-shadow: 0 2px 20px rgba(255,107,129,0.5); }
  50% { text-shadow: 0 2px 40px rgba(255,107,129,0.8), 0 0 60px rgba(255,107,129,0.3); }
}

.memory-progress {
  position: absolute;
  bottom: 40px;
  left: 50%;
  transform: translateX(-50%);
  width: 200px;
  height: 3px;
  background: rgba(255,255,255,0.2);
  border-radius: 3px;
  z-index: 4;
  overflow: hidden;
}
.memory-progress-fill {
  height: 100%;
  background: linear-gradient(90deg, #e83e8c, #ffb3c1);
  width: 0%;
  transition: width 0.3s linear;
  border-radius: 3px;
}

.memory-close-btn {
  position: absolute;
  top: 30px; right: 30px;
  background: rgba(255,255,255,0.1);
  backdrop-filter: blur(10px);
  border: 1px solid rgba(255,255,255,0.2);
  color: #fff;
  padding: 12px 24px;
  border-radius: 50px;
  font-family: 'Poppins', sans-serif;
  font-size: 0.9rem;
  cursor: pointer;
  z-index: 5;
  transition: all 0.3s ease;
}
.memory-close-btn:hover {
  background: rgba(255,255,255,0.2);
  transform: scale(1.05);
}

.memory-particle {
  position: absolute;
  pointer-events: none;
  z-index: 3;
  animation: particleFloat linear forwards;
}
@keyframes particleFloat {
  0% { opacity: 0; transform: translateY(0) scale(0); }
  10% { opacity: 1; transform: translateY(-20px) scale(1); }
  90% { opacity: 1; }
  100% { opacity: 0; transform: translateY(-100vh) scale(0.5) rotate(360deg); }
}

.memory-film-grain {
  position: absolute; inset: 0;
  opacity: 0.03;
  z-index: 3;
  pointer-events: none;
  background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='noise'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.9' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23noise)'/%3E%3C/svg%3E");
}

.memory-skip-hint {
  position: absolute;
  bottom: 80px;
  left: 50%;
  transform: translateX(-50%);
  color: rgba(255,255,255,0.4);
  font-family: 'Poppins', sans-serif;
  font-size: 0.8rem;
  z-index: 4;
  opacity: 0;
  transition: opacity 1s ease;
}
.memory-skip-hint.show {
  opacity: 1;
}
</style>
</head>
<body>

<audio id="realAudio" preload="none"></audio>

<div id="gate">
  <div class="gate-card">
    <div class="gate-title">Enter the secret code</div>
    <input type="text" id="codeInput" class="gate-input" placeholder="Type the code here..." autocomplete="off">
    <button class="gate-btn" onclick="checkCode()">Enter</button>
    <div class="gate-error" id="gateError">That's not the right code, my love...</div>
  </div>
</div>

<div id="app">
  <div class="welcome-banner">
    <h1>Welcome My Love</h1>
    <p>Enjoy your stay</p>
  </div>

  <div class="tabs-container">
    <button class="tab-btn active" onclick="switchTab('letter', this)">
      <span class="tab-icon">❤️</span> Love Letter
    </button>
    <button class="tab-btn" onclick="switchTab('music', this)">
      <span class="tab-icon">🎵</span> Music
    </button>
    <button class="tab-btn" onclick="switchTab('notes', this)">
      <span class="tab-icon">📝</span> Notes
    </button>
    <button class="tab-btn" onclick="switchTab('gallery', this)">
      <span class="tab-icon">🌹</span> Gallery
    </button>
    <button class="tab-btn memory-tab-btn" onclick="startMemoryMode()">
      <span class="tab-icon">✨</span> Memory
    </button>
  </div>

  <div class="content-area">
<div class="tab-content active" id="tab-letter">
  <div class="letter-header" onclick="toggleLetter()">Dearest</div>
  <div class="letter-sub">Letter For You</div>
  <div class="letter-divider" id="letterDivider"></div>
  <div class="letter-body" id="letterBody">
        <p>My love, every moment with you feels like a beautiful dream I never want to wake up from. You are the light that brightens my darkest days and the warmth that fills my heart with joy.</p>
        <p>I created this little corner of the internet just for you — a place where my love for you lives forever in code, just as it lives forever in my heart.</p>
        <p>You are my universe, my everything, my forever. I love you more than words could ever express, and I am so grateful to have you in my life.</p>
        <p style="text-align: right; margin-top: 20px;">Yours always,<br>❤️</p>
      </div>
      <div class="cat-gif-container">
        <img src="https://media3.giphy.com/media/v1.Y2lkPTc5MGI3NjExMHFvNzZtbnd0Mzh2dng5NWdvOWVoYzQxdDR2NzBiZWtqNTlwcTlhNSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/MDJ9IbxxvDUQM/giphy.gif" alt="Cute Cat" onerror="this.src='https://media3.giphy.com/media/v1.Y2lkPTc5MGI3NjExMHFvNzZtbnd0Mzh2dng5NWdvOWVoYzQxdDR2NzBiZWtqNTlwcTlhNSZlcD12MV9pbnRlcm5hbF9naWZfYnlfaWQmY3Q9Zw/MDJ9IbxxvDUQM/giphy.gif'">
        <div class="cat-caption">This is how I feel about you every day! 💕</div>
      </div>
    </div>

    <div class="tab-content" id="tab-music">
      <div class="music-header">Our Playlist</div>

      <div class="song-card" id="song-0" onclick="playSong(0)">
        <div class="song-number">1</div>
        <div class="song-info">
          <div class="song-title">You're Gonna Live Forever in Me</div>
          <div class="song-artist">John Mayer</div>
        </div>
        <div class="song-viz">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="play-icon" id="icon-0">▶</div>
      </div>

      <div class="song-card" id="song-1" onclick="playSong(1)">
        <div class="song-number">2</div>
        <div class="song-info">
          <div class="song-title">Your Universe</div>
          <div class="song-artist">Rico Blanco</div>
        </div>
        <div class="song-viz">
          <span></span><span></span><span></span><span></span><span></span>
        </div>
        <div class="play-icon" id="icon-1">▶</div>
      </div>
    </div>

    <div class="tab-content" id="tab-notes">
      <div class="notes-header">Our Little Notes</div>
      <div class="note-input-area">
        <input type="text" class="note-input" id="noteInput" placeholder="Write a sweet note for her..." maxlength="200">
        <button class="note-add-btn" onclick="addNote()">Add 💕</button>
      </div>
      <div class="notes-list" id="notesList">
        <div class="empty-notes">No notes yet... Write something sweet! ✨</div>
      </div>
    </div>

    <div class="tab-content" id="tab-gallery">
      <div class="gallery-header">Our Memories</div>
      <div class="gallery-grid" id="galleryGrid">
        <div class="gallery-slot has-image" id="slot-0">
          <img src="data:image/png;base64," alt="Memory 1">
        </div>
        <div class="gallery-slot has-image" id="slot-1">
          <img src="data:image/png;base64," alt="Memory 2">
        </div>
        <div class="gallery-slot has-image" id="slot-2">
          <img src="data:image/png;base64," alt="Memory 3">
        </div>
        <div class="gallery-slot has-image" id="slot-3">
          <img src="data:image/png;base64," alt="Memory 4">
        </div>
        <div class="gallery-slot has-image" id="slot-4">
          <img src="data:image/png;base64," alt="Memory 5">
        </div>
        <div class="gallery-slot has-image" id="slot-5">
          <img src="data:image/png;base64," alt="Memory 6">
        </div>
        <div class="gallery-slot has-image" id="slot-6">
          <img src="data:image/png;base64," alt="Memory 7">
        </div>
        <div class="gallery-slot has-image" id="slot-7">
          <img src="data:image/png;base64," alt="Memory 8">
        </div>
      </div>
    </div>
  </div>
</div>

<div class="now-playing-bar" id="nowPlayingBar">
  <div class="np-info">
    <div class="np-title" id="npTitle">Select a song</div>
    <div class="np-artist" id="npArtist">Tap a song to play</div>
  </div>
  <div class="visualizer-bars" id="vizBars">
    <span></span><span></span><span></span><span></span><span></span>
  </div>
  <div class="np-controls">
    <button class="np-btn" onclick="prevSong()">⏮</button>
    <button class="np-btn" onclick="togglePlay()" id="playPauseBtn">▶</button>
    <button class="np-btn" onclick="nextSong()">⏭</button>
  </div>
  <div class="np-progress">
    <div class="np-progress-fill" id="npProgress"></div>
  </div>
</div>

<script>
const SECRET_CODE = "august 3, 2025";

function checkCode() {
  const input = document.getElementById('codeInput').value.trim().toLowerCase();
  const error = document.getElementById('gateError');
  if (input === SECRET_CODE) {
    document.getElementById('gate').classList.add('hidden');
    setTimeout(() => {
      document.getElementById('app').classList.add('show');
      startFloatingHearts();
    }, 400);
  } else {
    error.classList.add('show');
    document.getElementById('codeInput').style.borderColor = '#dc3545';
    setTimeout(() => {
      error.classList.remove('show');
      document.getElementById('codeInput').style.borderColor = '#e83e8c';
    }, 2000);
  }
}

document.getElementById('codeInput').addEventListener('keypress', (e) => {
  if (e.key === 'Enter') checkCode();
});

function startFloatingHearts() {
  const hearts = ['❤️', '💖', '💕', '💗', '💝', '💘'];
  setInterval(() => {
    const heart = document.createElement('div');
    heart.className = 'floating-heart';
    heart.textContent = hearts[Math.floor(Math.random() * hearts.length)];
    heart.style.left = Math.random() * 100 + 'vw';
    heart.style.animationDuration = (4 + Math.random() * 4) + 's';
    heart.style.fontSize = (1 + Math.random() * 1.5) + 'rem';
    document.body.appendChild(heart);
    setTimeout(() => heart.remove(), 8000);
  }, 800);
}

function toggleLetter() {
  const body = document.getElementById('letterBody');
  const header = document.querySelector('.letter-header');
  const divider = document.getElementById('letterDivider');
  
  body.classList.toggle('expanded');
  header.classList.toggle('expanded');
  divider.classList.toggle('expanded');
}

function switchTab(tabName, btn) {
  // Remove active class from all tab buttons
  document.querySelectorAll('.tab-btn').forEach(b => b.classList.remove('active'));
  // Add active class to clicked button
  btn.classList.add('active');

  // Hide all tab content
  document.querySelectorAll('.tab-content').forEach(c => c.classList.remove('active'));
  // Show selected tab content
  document.getElementById('tab-' + tabName).classList.add('active');
}

// Embedded audio data URLs - works anywhere, no external files needed!
const songs = [
  { title: "You're Gonna Live Forever in Me", artist: "John Mayer", src: "data:audio/mp3;base64," },
  { title: "Your Universe", artist: "Rico Blanco", src: "data:audio/mp3;base64," }
];

let currentSong = -1;
let isPlaying = false;
const audio = document.getElementById('realAudio');

audio.addEventListener('ended', () => {
  nextSong();
});

audio.addEventListener('timeupdate', () => {
  if (audio.duration) {
    const pct = (audio.currentTime / audio.duration) * 100;
    document.getElementById('npProgress').style.width = pct + '%';
  }
});

audio.addEventListener('error', (e) => {
  console.error('Audio error:', e);
  alert('Audio failed to load. Please try again.');
  resetPlayer();
});

function resetPlayer() {
  if (currentSong !== -1) {
    document.getElementById('song-' + currentSong).classList.remove('playing');
    document.getElementById('icon-' + currentSong).textContent = '▶';
  }
  isPlaying = false;
  currentSong = -1;
  document.getElementById('nowPlayingBar').classList.remove('show');
  document.getElementById('vizBars').classList.remove('active');
}

function playSong(index) {
  if (currentSong === index && isPlaying) {
    pauseCurrent();
    return;
  }

  if (currentSong !== -1) {
    document.getElementById('song-' + currentSong).classList.remove('playing');
    document.getElementById('icon-' + currentSong).textContent = '▶';
  }

  currentSong = index;
  audio.src = songs[index].src;
  audio.load();

  audio.play().then(() => {
    isPlaying = true;
    document.getElementById('song-' + index).classList.add('playing');
    document.getElementById('icon-' + index).textContent = '⏸';
    document.getElementById('npTitle').textContent = songs[index].title;
    document.getElementById('npArtist').textContent = songs[index].artist;
    document.getElementById('nowPlayingBar').classList.add('show');
    document.getElementById('playPauseBtn').textContent = '⏸';
    document.getElementById('vizBars').classList.add('active');
  }).catch(err => {
    console.error('Audio play failed:', err);
    alert('Could not play audio. Browser may have blocked autoplay. Try clicking again.');
    resetPlayer();
  });
}

function pauseCurrent() {
  isPlaying = false;
  audio.pause();
  if (currentSong !== -1) {
    document.getElementById('icon-' + currentSong).textContent = '▶';
    document.getElementById('song-' + currentSong).classList.remove('playing');
  }
  document.getElementById('playPauseBtn').textContent = '▶';
  document.getElementById('vizBars').classList.remove('active');
}

function togglePlay() {
  if (currentSong === -1) { playSong(0); return; }
  if (isPlaying) {
    pauseCurrent();
  } else {
    audio.play().then(() => {
      isPlaying = true;
      document.getElementById('icon-' + currentSong).textContent = '⏸';
      document.getElementById('song-' + currentSong).classList.add('playing');
      document.getElementById('playPauseBtn').textContent = '⏸';
      document.getElementById('vizBars').classList.add('active');
    });
  }
}

function nextSong() {
  let next = currentSong + 1;
  if (next >= songs.length) next = 0;
  playSong(next);
}

function prevSong() {
  let prev = currentSong - 1;
  if (prev < 0) prev = songs.length - 1;
  playSong(prev);
}

let notes = [];

function addNote() {
  const input = document.getElementById('noteInput');
  const text = input.value.trim();
  if (!text) return;
  notes.push({ id: Date.now(), text: text });
  input.value = '';
  renderNotes();
}

document.getElementById('noteInput').addEventListener('keypress', (e) => {
  if (e.key === 'Enter') addNote();
});

function renderNotes() {
  const list = document.getElementById('notesList');
  if (notes.length === 0) {
    list.innerHTML = '<div class="empty-notes">No notes yet... Write something sweet! ✨</div>';
    return;
  }
  list.innerHTML = notes.map(n => `
    <div class="note-item">
      <span class="note-text">${escapeHtml(n.text)}</span>
      <button class="note-delete" onclick="deleteNote(${n.id})">🗑️</button>
    </div>
  `).join('');
}

function deleteNote(id) {
  notes = notes.filter(n => n.id !== id);
  renderNotes();
}

function escapeHtml(text) {
  const div = document.createElement('div');
  div.textContent = text;
  return div.innerHTML;
}

function handlePhoto(input, slotIndex) {
  const file = input.files[0];
  if (!file) return;
  const reader = new FileReader();
  reader.onload = (e) => {
    const slot = document.getElementById('slot-' + slotIndex);
    slot.classList.add('has-image');
    slot.innerHTML = `<img src="${e.target.result}" alt="Memory">`;
  };
  reader.readAsDataURL(file);
}

// ===== MEMORY MODE =====
let memoryInterval = null;
let memoryAudio = null;
let memoryPhotos = [];
let memoryCaptions = [
  { title: "The Day We Met", subtitle: "Every love story has a beginning... and ours started with a smile" },
  { title: "Our First Adventure", subtitle: "Side by side, hand in hand, making memories we'll never forget" },
  { title: "Laughter & Joy", subtitle: "In your arms, I found my favorite place in the world" },
  { title: "The Little Things", subtitle: "It's not the grand gestures, it's the way you look at me" },
  { title: "Growing Together", subtitle: "Every day with you feels like coming home" },
  { title: "Forever & Always", subtitle: "You're not just my love, you're my best friend, my home, my everything" },
  { title: "Our Promise", subtitle: "Through every storm, through every sunrise — I'm yours" },
  { title: "To Infinity", subtitle: "Some hearts are meant to beat together... forever" }
];
let memoryCurrentIndex = 0;
let memoryTotalTime = 0;
let memoryDuration = 48000;
let memorySlideDuration = 6000;

function getGalleryPhotos() {
  const photos = [];
  for (let i = 0; i < 8; i++) {
    const slot = document.getElementById('slot-' + i);
    const img = slot.querySelector('img');
    if (img && img.src) {
      photos.push(img.src);
    }
  }
  return photos.length > 0 ? photos : null;
}

function startMemoryMode() {
  const photos = getGalleryPhotos();
  if (!photos || photos.length === 0) {
    alert('Add some photos to the Gallery first! 📸');
    switchTab('gallery', document.querySelectorAll('.tab-btn')[3]);
    return;
  }

  memoryPhotos = photos;
  memoryCurrentIndex = 0;
  memoryTotalTime = 0;

  const overlay = document.getElementById('memoryOverlay');
  const bg = document.getElementById('memoryBg');
  const photo = document.getElementById('memoryPhoto');
  const text = document.getElementById('memoryText');
  const title = document.getElementById('memoryTitle');
  const subtitle = document.getElementById('memorySubtitle');
  const progress = document.getElementById('memoryProgress');
  const skipHint = document.getElementById('memorySkipHint');

  overlay.classList.add('active');

  playSong(0);

  setTimeout(() => skipHint.classList.add('show'), 3000);

  showMemorySlide();

  let lastSlideTime = -memorySlideDuration;
  
  memoryInterval = setInterval(() => {
    memoryTotalTime += 100;
    const pct = (memoryTotalTime / memoryDuration) * 100;
    progress.style.width = pct + '%';
    
    if (memoryTotalTime - lastSlideTime >= memorySlideDuration) {
      lastSlideTime = memoryTotalTime;
      memoryCurrentIndex = (memoryCurrentIndex + 1) % memoryPhotos.length;
      showMemorySlide();
    }
    
    if (memoryTotalTime >= memoryDuration) {
      stopMemoryMode();
    }
  }, 100);

  overlay.onclick = (e) => {
    if (e.target.classList.contains('memory-close-btn')) return;
    memoryCurrentIndex = (memoryCurrentIndex + 1) % memoryPhotos.length;
    showMemorySlide();
  };

  spawnMemoryParticles();
}

function showMemorySlide() {
  const bg = document.getElementById('memoryBg');
  const photo = document.getElementById('memoryPhoto');
  const text = document.getElementById('memoryText');
  const title = document.getElementById('memoryTitle');
  const subtitle = document.getElementById('memorySubtitle');

  const currentPhoto = memoryPhotos[memoryCurrentIndex];
  const caption = memoryCaptions[memoryCurrentIndex % memoryCaptions.length];

  photo.classList.remove('active');
  text.classList.remove('active');
  bg.classList.remove('active');

  setTimeout(() => {
    bg.style.backgroundImage = `url('${currentPhoto}')`;
    photo.src = currentPhoto;
    title.textContent = caption.title;
    subtitle.textContent = caption.subtitle;

    bg.classList.add('active');
    photo.classList.add('active');
    text.classList.add('active');
  }, 500);
}

function spawnMemoryParticles() {
  const overlay = document.getElementById('memoryOverlay');
  const particles = ['✨', '💖', '💕', '💗', '💝', '💘', '⭐', '🌟'];

  const particleInterval = setInterval(() => {
    if (!document.getElementById('memoryOverlay').classList.contains('active')) {
      clearInterval(particleInterval);
      return;
    }

    const p = document.createElement('div');
    p.className = 'memory-particle';
    p.textContent = particles[Math.floor(Math.random() * particles.length)];
    p.style.left = Math.random() * 100 + 'vw';
    p.style.bottom = '-50px';
    p.style.fontSize = (1 + Math.random() * 2) + 'rem';
    p.style.animationDuration = (4 + Math.random() * 4) + 's';
    p.style.opacity = 0.3 + Math.random() * 0.4;
    overlay.appendChild(p);

    setTimeout(() => p.remove(), 8000);
  }, 600);
}

function stopMemoryMode() {
  if (memoryInterval) {
    clearInterval(memoryInterval);
    memoryInterval = null;
  }

  const overlay = document.getElementById('memoryOverlay');
  overlay.classList.remove('active');

  const audio = document.getElementById('realAudio');
  audio.pause();
  audio.currentTime = 0;

  document.getElementById('memoryProgress').style.width = '0%';
  document.getElementById('memorySkipHint').classList.remove('show');

  document.querySelectorAll('.song-card').forEach(c => c.classList.remove('playing'));
  document.querySelectorAll('.play-icon').forEach((icon, i) => icon.textContent = '▶');
  document.getElementById('vizBars').classList.remove('active');
  document.getElementById('nowPlayingBar').classList.remove('show');
  document.getElementById('npTitle').textContent = 'Select a song';
  document.getElementById('npArtist').textContent = 'Tap a song to play';
  document.getElementById('playPauseBtn').textContent = '▶';
  currentSongIndex = -1;
  isPlaying = false;
}
</script>

<div id="memoryOverlay">
  <div class="memory-bg-layer" id="memoryBg"></div>
  <div class="memory-film-grain"></div>
  <div class="memory-vignette"></div>
  <img class="memory-main-photo" id="memoryPhoto" src="" alt="Memory">
  <div class="memory-text" id="memoryText">
    <h2 id="memoryTitle"></h2>
    <p id="memorySubtitle"></p>
  </div>
  <div class="memory-progress">
    <div class="memory-progress-fill" id="memoryProgress"></div>
  </div>
  <div class="memory-skip-hint" id="memorySkipHint">Click anywhere to skip</div>
  <button class="memory-close-btn" onclick="stopMemoryMode()">✕ Close Memory</button>
</div>

</body>
</html
